AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_LUNA=
AZURE_OPENAI_DEPLOYMENT_TERRA=
AZURE_OPENAI_DEPLOYMENT_SOL=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
REASONING_LUNA_EXTRACTION=medium
REASONING_TERRA_EXTRACTION=high
REASONING_TERRA_REVIEW=high
REASONING_SOL_REEXTRACTION=high
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=2
EXTRACTION_MAX_OUTPUT_TOKENS=32768
COMPLETENESS_MAX_OUTPUT_TOKENS=8192
OPENAI_PROMPT_CACHE_MODE=explicit
OPENAI_PROMPT_CACHE_NAMESPACE=tender-extraction-v1
OPENAI_PROMPT_CACHE_TTL=30m
MAX_INPUT_BYTES=20000000
MAX_SOURCE_BYTES=100000000
# Only needed for DOCX. Example: C:/Program Files/LibreOffice/program/soffice.exe
LIBREOFFICE_PATH=soffice
